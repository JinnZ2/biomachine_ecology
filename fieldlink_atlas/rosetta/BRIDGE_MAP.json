    "glyph_bridge": {
        "source": "materials_glyph_bank/glyph-index.csv",
        "target": "fieldlink_atlas/rosetta/vocab.json",
        "note": "BioMachine glyphs encode scrap-material semantics; Rosetta vocab encodes shape-intelligence semantics. The two glyph systems are complementary — material glyphs describe WHAT things are made of, shape glyphs describe HOW they relate."
    }
